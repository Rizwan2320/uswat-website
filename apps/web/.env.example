# Postgres connection string (local dev: see ops/docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/uswat

# Used to encrypt JWT tokens. 16+ characters. Generate: openssl rand -hex 32
PAYLOAD_SECRET=change-me-change-me-change-me

# Public site URL, no trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Bearer secret for POST /api/payload-jobs/run (scheduled publish). 16+ characters.
CRON_SECRET=change-me-change-me-change-me

# Validates preview requests. 16+ characters.
PREVIEW_SECRET=change-me-change-me-change-me
